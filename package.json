{
  "name": "repo-nadi",
  "version": "1.0.0",
  "description": "A batteries-included web project template built on Vite.",
  "keywords": [
    "template",
    "typescript",
    "vite"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest --run --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "oxfmt .",
    "fmt": "oxfmt ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.17.0"
}
