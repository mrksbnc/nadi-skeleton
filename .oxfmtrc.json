{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules", ".husky", "dist"],
  "sortImports": {
    "paths": true,
    "sortSideEffects": true,
    "newlinesBetween": false
  }
}
